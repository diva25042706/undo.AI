# ============================================================
# UNDO.AI Backend Environment Configuration
# ============================================================

# Database (PostgreSQL with asyncpg or SQLite fallback)
DATABASE_URL=postgresql+asyncpg://undo_user:undo_secret@localhost:5432/undo_ai_db
# For zero-dependency local SQLite testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./undo_ai.db

# Redis for Distributed Caching and Locks
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=super-secure-undo-ai-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration ('gemini', 'openai', or 'mock')
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gemini-2.0-flash

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=UNDO.AI Engine
APP_VERSION=1.0.0
